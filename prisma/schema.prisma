generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model DeviceType {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  specs       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id           String                   @id @default(cuid())
  title        String
  slug         String                   @unique
  ingress      String?
  categoryId   String
  deviceTypeId String
  keywords     String[]                 @default([])
  updatedAt    DateTime                 @updatedAt
  createdAt    DateTime                 @default(now())
  category     Category                 @relation(fields: [categoryId], references: [id])
  deviceType   DeviceType               @relation(fields: [deviceTypeId], references: [id])
  steps        Step[]
  sessions     TroubleshootingSession[]

  @@index([categoryId])
  @@index([deviceTypeId])
}

model Step {
  id             String              @id @default(cuid())
  title          String
  localeKey      String
  agentNote      String?
  imageUrl       String?
  articleId      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessionAnswers SessionStepAnswer[]
  article        Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  incomingLinks  StepChoice[]        @relation("ToStep")
  choices        StepChoice[]        @relation("FromStep")

  @@index([articleId])
}

model StepChoice {
  id             String              @id @default(cuid())
  stepId         String
  label          String
  buttonText     String?
  value          String?
  nextStepId     String?
  sortOrder      Int                 @default(0)
  isTerminal     Boolean             @default(false)
  terminalReason TerminalReason?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessionAnswers SessionStepAnswer[]
  nextStep       Step?               @relation("ToStep", fields: [nextStepId], references: [id])
  step           Step                @relation("FromStep", fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, sortOrder])
  @@index([nextStepId])
}

model SessionStepAnswer {
  id         String                 @id @default(cuid())
  sessionId  String
  stepId     String
  choiceId   String?
  customText String?
  createdAt  DateTime               @default(now())
  choice     StepChoice?            @relation(fields: [choiceId], references: [id])
  session    TroubleshootingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step       Step                   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepId])
  @@index([choiceId])
}

model TroubleshootingSession {
  id               String              @id @default(cuid())
  sessionCode      String              @unique
  articleId        String
  completed        Boolean             @default(false)
  outcome          SessionOutcome      @default(IN_PROGRESS)
  escalationReason String?
  customerServiceNotes String?
  routerModel      String?
  customerId       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  answers          SessionStepAnswer[]
  aiInteractions   AiAssistInteraction[]
  article          Article             @relation(fields: [articleId], references: [id])
  customer         User?               @relation(fields: [customerId], references: [id])

  @@index([articleId])
  @@index([outcome])
}

model User {
  id            String    @id @default(cuid())
  name          String   
  email         String    @unique
  emailVerified Boolean   @default(false)
  firstName     String
  lastName      String
  role          Role      @default(AGENT)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions       TroubleshootingSession[]
  authSessions   Session[]
  accounts       Account[]
  aiInteractions AiAssistInteraction[]
}


model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AiAssistInteraction {
  id         String                  @id @default(cuid())
  agentId    String
  sessionId  String?
  agentNotes String?
  aiResponse String
  model      String
  createdAt  DateTime                @default(now())
  agent      User                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session    TroubleshootingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([sessionId])
}

enum Role {
  AGENT
  CUSTOMER
}

enum SessionOutcome {
  IN_PROGRESS
  RESOLVED
  ESCALATED
  ABANDONED
}

enum TerminalReason {
  SPEEDTEST
  EXTERNAL_REDIRECT
  FLOW_EXIT_EXPECTED_SPEED
  FLOW_EXIT_NO_NEXT_STEP
  FILTERED_CROSS_FLOW
}
